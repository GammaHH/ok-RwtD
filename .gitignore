# ========================================
# OK Development Template
# ========================================

# Track reusable task templates
!/ok_tasks/
!/ok_tasks/*.py

# Keep development tools
!/dev_tools/
!/dev_tools/*.bat

# Ignore backups
_template_backup_*/
_removed_tasks/

# Ignore temporary files
*.bak
*.pyc

# Project-local runtime, editor attachments and generated reports
/.codex-attachments/
/.codex-remote-attachments/
/.venv*/
/packaging_logs/
/screenshots/
/pyappify_dist/
/assets/rwtd/runtime/
/assets/rwtd/manual_requests/
/assets/rwtd/presets/
/assets/rwtd/modules/**/backups/
/assets/rwtd/scheduler/backups/
/assets/rwtd/scheduler/time_guards.json
/assets/rwtd/scheduler/theme.json
/docs/rwtd/analysis/
/docs/rwtd/exceptions/
/docs/rwtd/notifications/
/docs/rwtd/backups/

# Ignore local environment
cache/
known-good/

# Ignore secrets
.env
.env.*
!.env.example

# Local runtime configurations
/configs/
/logs/
/assets/rwtd/runtime/farm_round_timings.sqlite3*

# Local backups
/_template_backup_*/
/_removed_tasks/

# Python cache
__pycache__/
*.pyc
